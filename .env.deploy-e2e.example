# 실제 값은 .env.deploy-e2e.local (gitignore 대상) 또는 CI Secret Store에만 넣는다.
# 이 파일에는 플레이스홀더만 유지한다. 값을 채워서 커밋하지 않는다.

# 승인된 배포 Origin (동일 Origin 구조면 두 값이 같아야 함, 다르면 실행 중단)
DORO_FRONTEND_ORIGIN=https://doro.minseok.click
DORO_API_ORIGIN=https://doro.minseok.click

# AUTH_VALID_01 (정상 계정 — sample-store/owner)
DORO_AUTH_VALID_01_TENANT_CODE=sample-store
DORO_AUTH_VALID_01_LOGIN_ID=owner
DORO_AUTH_VALID_01_PASSWORD=

# 잠금/비활성/Role/임시비밀번호/비밀번호rotate 등 조건부 정적 계정 8개
# (준비되기 전까지 비워두면 해당 계정을 쓰는 케이스만 SKIP_PRECONDITION — 폴백 없음)
# 각 계정이 갖춰야 하는 정확한 상태는 Docs/Specifications/운영·배포/"배포 검증용 테스트 계정 요청.md" 참고
DORO_AUTH_LOCKOUT_01_TENANT_CODE=
DORO_AUTH_LOCKOUT_01_LOGIN_ID=
DORO_AUTH_LOCKOUT_01_PASSWORD=

DORO_AUTH_INACTIVE_EMPLOYEE_01_TENANT_CODE=
DORO_AUTH_INACTIVE_EMPLOYEE_01_LOGIN_ID=
DORO_AUTH_INACTIVE_EMPLOYEE_01_PASSWORD=

DORO_AUTH_INACTIVE_TENANT_01_TENANT_CODE=
DORO_AUTH_INACTIVE_TENANT_01_LOGIN_ID=
DORO_AUTH_INACTIVE_TENANT_01_PASSWORD=

# FE-BE-014는 아래 ROLE 3계정이 전부 있어야 실행된다(하나라도 비면 스킵)
DORO_AUTH_ROLE_OWNER_01_TENANT_CODE=
DORO_AUTH_ROLE_OWNER_01_LOGIN_ID=
DORO_AUTH_ROLE_OWNER_01_PASSWORD=

DORO_AUTH_ROLE_MANAGER_01_TENANT_CODE=
DORO_AUTH_ROLE_MANAGER_01_LOGIN_ID=
DORO_AUTH_ROLE_MANAGER_01_PASSWORD=

DORO_AUTH_ROLE_STAFF_01_TENANT_CODE=
DORO_AUTH_ROLE_STAFF_01_LOGIN_ID=
DORO_AUTH_ROLE_STAFF_01_PASSWORD=

DORO_AUTH_TEMP_PASSWORD_01_TENANT_CODE=
DORO_AUTH_TEMP_PASSWORD_01_LOGIN_ID=
DORO_AUTH_TEMP_PASSWORD_01_PASSWORD=

# 예외적으로 4값(A/B) — SESS-005가 매 실행마다 현재 값을 스스로 판별해 반대쪽으로 바꾼다
DORO_AUTH_PASSWORD_ROTATE_01_TENANT_CODE=
DORO_AUTH_PASSWORD_ROTATE_01_LOGIN_ID=
DORO_AUTH_PASSWORD_ROTATE_01_PASSWORD_A=
DORO_AUTH_PASSWORD_ROTATE_01_PASSWORD_B=

# 잠금/Rate Limit 등 파괴적 시나리오 실행 여부 (기본 false)
RUN_DESTRUCTIVE_AUTH_TESTS=false

# FE-BE-012, OPS-001/002/003/005 등 장애 주입 시나리오 실행 여부 (기본 false)
RUN_FAULT_INJECTION_TESTS=false

# Deployment Identity(Revision) — scripts/resolve-deployment-identity.mjs가 자동으로 채운다.
# 직접 값을 넣지 말고 해당 스크립트를 실행해 .env.deployment-identity.local을 생성한 뒤 source한다.
DORO_FRONTEND_REVISION=
DORO_CLOUDFRONT_DISTRIBUTION_ID=
DORO_EDGE_REVISION=
DORO_STORE_ACCESS_REVISION=
